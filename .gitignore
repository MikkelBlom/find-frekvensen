# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# electron portable build output
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# launchpad: everything is committed on purpose — the binding
# (.launchpad.json), the human-readable mirror (LAUNCHPAD.md) and the machine-
# readable snapshot (.launchpad-snapshot.json). The snapshot is the only
# re-pushable backup of this project's tasks/ideas/notes if Launchpad's own
# database loses them; it was needed once already, on 2026-07-30.
